# Backend only. Use these for your backend hosting service.
# Never expose these values in frontend/client-side JavaScript.
NODE_ENV=production
PORT=5001
FRONTEND_URL=https://nervargd.vercel.app
CORS_ORIGIN=https://nervargd.vercel.app
CORS_ORIGINS=https://nervargd.vercel.app
ALLOWED_ORIGINS=https://nervargd.vercel.app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=base64-encoded-32-byte-key
ML_API_URL=https://NEW-ML-HOSTING-URL

# Local testing example:
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://nervargd.vercel.app
# ML_API_URL=http://localhost:8000

# Optional: only needed if forgot-password email sending is enabled.
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
