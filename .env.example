# NERVA uses separate environment files after the frontend/backend split.
#
# Backend secrets and server config:
#   backend/.env.example
#
# Frontend public config:
#   frontend/.env.example
#
# Local testing URLs:
#   frontend/.env.local -> VITE_API_BASE_URL=http://localhost:5001
#   frontend/.env.local -> VITE_ML_API_URL=http://localhost:8000
#   backend/.env.local  -> ML_API_URL=http://localhost:8000
#
# Do not put Supabase service keys, JWT secrets, encryption keys, or SMTP
# passwords in frontend environment variables.
